#!/bin/bash

# Define your internal and external monitors
internal="eDP-1"
external="DP-1-3.1"

# Check if the external monitor is connected
if xrandr | grep "$external connected"; then
    # External monitor is connected
    xrandr --output "$internal" --mode 1920x1200 --primary
    xrandr --output "$external" --mode 1920x1080 --rate 60.00 --above "$internal"
else
    # External monitor is not connected, so just configure the internal monitor
    xrandr --output "$internal" --mode 1920x1200 --primary
fi

# Set environment variables
export GTK_THEME=Adwaita:dark
export QT_QPA_PLATFORMTHEME="qt5ct"

# Start some applications automatically (ensure they don't block by adding &)
nm-applet &
# picom --experimental-backends &
[[ -f ~/.Xresources ]] && xrdb -merge ~/.Xresources

