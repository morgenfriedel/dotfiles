# dunst 1.9 — matches the polybar palette. Reference: man 5 dunst.
#
# Keys live in i3/config (dunst 1.6+ has no shortcuts of its own):
#   $mod+n          dismiss newest
#   $mod+Shift+n    bring back the last dismissed
#   $mod+Ctrl+n     dismiss all
#   $mod+Shift+d    do-not-disturb toggle (bell icon in polybar while on)
#
# Do-not-disturb holds every notification, critical included, until it's
# turned off; dunst 1.9 has no way to let some through. battery-alert.sh
# turns it off at 5% so a dying battery still gets through.

[global]
    # Show on the monitor with keyboard focus, just under the bar.
    follow = keyboard
    origin = top-right
    offset = 20x52
    width = 340
    height = 300
    notification_limit = 4
    indicate_hidden = yes

    progress_bar = true
    progress_bar_height = 8
    progress_bar_frame_width = 0
    progress_bar_min_width = 316
    progress_bar_max_width = 316
    progress_bar_corner_radius = 4

    font = Hack Nerd Font 10
    markup = full
    format = "<b>%s</b>\n%b"
    alignment = left
    vertical_alignment = center
    ellipsize = middle
    show_age_threshold = 60
    stack_duplicates = true
    hide_duplicate_count = false
    show_indicators = yes

    padding = 10
    horizontal_padding = 12
    text_icon_padding = 10
    frame_width = 2
    gap_size = 6
    separator_height = 2
    separator_color = frame
    corner_radius = 6
    min_icon_size = 0
    max_icon_size = 32

    # Keep notifications on screen while away from the keyboard (seconds).
    idle_threshold = 120
    sort = yes
    sticky_history = yes
    history_length = 30

    dmenu = rofi -dmenu -i -p dunst
    browser = /usr/bin/xdg-open

    # Left click runs the notification's action (e.g. opens the Slack thread)
    # and dismisses it; right click dismisses everything.
    mouse_left_click = do_action, close_current
    mouse_middle_click = close_current
    mouse_right_click = close_all

# Volume and brightness popups, and other quiet status messages.
[urgency_low]
    background = "#282A2E"
    foreground = "#C5C8C6"
    frame_color = "#373B41"
    highlight = "#F0C674"
    timeout = 4

[urgency_normal]
    background = "#282A2E"
    foreground = "#C5C8C6"
    frame_color = "#F0C674"
    highlight = "#F0C674"
    timeout = 8

# Same red as polybar's low-battery block. Stays until dismissed.
[urgency_critical]
    background = "#A54242"
    foreground = "#FFFFFF"
    frame_color = "#CC6666"
    highlight = "#FFFFFF"
    timeout = 0

# Key feedback from i3/scripts; not worth keeping in history.
[volume]
    appname = volume
    history_ignore = yes

[brightness]
    appname = brightness
    history_ignore = yes

# Screenshot preview above the text (screenshot.sh).
[screenshot]
    appname = screenshot
    icon_position = top
    max_icon_size = 300
    history_ignore = yes
