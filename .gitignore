# Local/work overrides - never published (see README)
home/.bash_work
.bash_work

# Generated by Neovim once ~/.config/nvim is a symlink into this repo
config/nvim/plugin/packer_compiled.lua
config/nvim/lazy-lock.json
config/nvim/spell/
config/nvim/.netrwhist
config/nvim/shada/

# Plugin manager checkouts, in case anything lands here
config/nvim/pack/
config/nvim/plugged/
config/nvim/autoload/plug.vim

# Editor/nvim leftovers
*.bak
*.swp
*.swo
*~

# Installer backups
.dotfiles-backup/

# Downloaded archives (e.g. Neovim release tarballs) - never commit binaries
*.tar.gz
*.appimage
*.zip
